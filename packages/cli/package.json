{
  "name": "create-ts-monorepo-starter",
  "version": "0.1.0",
  "description": "Create a TypeScript monorepo from the ts-monorepo-starter template",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prosdevlab/create-ts-monorepo-starter.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "create-ts-monorepo-starter": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json && node -e \"fs.chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src ./test",
    "format": "biome format --write ./src ./test",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.6",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
