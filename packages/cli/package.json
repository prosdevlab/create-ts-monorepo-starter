{
  "name": "create-ts-monorepo-starter",
  "version": "1.0.0",
  "description": "Create a TypeScript monorepo from the ts-monorepo-starter template",
  "keywords": [
    "create",
    "scaffold",
    "typescript",
    "monorepo",
    "pnpm",
    "turborepo"
  ],
  "license": "MIT",
  "homepage": "https://github.com/prosdevlab/create-ts-monorepo-starter#readme",
  "bugs": {
    "url": "https://github.com/prosdevlab/create-ts-monorepo-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prosdevlab/create-ts-monorepo-starter.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "create-ts-monorepo-starter": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json --outDir build && rollup -c && node scripts/fetch-template.mjs && node -e \"fs.chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsc -p tsconfig.json --outDir build --watch",
    "clean": "node -e \"for (const d of ['dist', 'build']) fs.rmSync(d, { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src ./test ./scripts rollup.config.js",
    "format": "biome format --write ./src ./test ./scripts rollup.config.js",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "22.20.5",
    "rollup": "4.65.0",
    "rollup-plugin-license": "3.7.1",
    "typescript": "7.0.2"
  }
}
